.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.streamlit/secrets.toml
.env
data/
# The pattern above ignores any directory named "data" at any depth, which
# silently swallowed pwa/src/data/templates.ts (the step templates). It existed
# locally so tsc passed, but it was never committed, so the first Vercel build
# failed with TS2307 "Cannot find module '../data/templates'". Re-include the
# PWA's data dir; the Streamlit ignore above is unaffected.
!pwa/src/data/
.DS_Store
Thumbs.db

# Supabase CLI scratch state (project-ref, cached CLI version). `supabase init`
# writes its own pwa/supabase/.gitignore; this covers a run where it was skipped.
# A pattern with a slash is anchored to this file's directory, so it must be
# spelled out — `supabase/.temp/` alone would not match pwa/supabase/.temp.
pwa/supabase/.temp/
